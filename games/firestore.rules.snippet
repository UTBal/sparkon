// SparkON least-privilege section for board-18d33 (paste inside
// match /databases/{database}/documents { ... } alongside Whiteboard).
// Do NOT weaken users/{userId}/notes/{noteId}.
// NOT deployed from this box — Alex/Builder must publish in Firebase Console.
// Guests/TVs: Firebase Anonymous Auth. hostUid / member ids / displayId = auth.uid.
// Seats (2–6 players, start ≥2) are client-enforced in room.js / play-app.js — not in rules.
// Stakes / card escrow Cloud Functions: NOT tonight — collection create-only; transfers later.

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function roomPath(roomId) {
      return /databases/$(database)/documents/sparkonRooms/$(roomId);
    }
    function roomData(roomId) { return get(roomPath(roomId)).data; }
    function isRoomHost(roomId) {
      return signedIn() && roomData(roomId).hostUid == request.auth.uid;
    }
    function isMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sparkonRooms/$(roomId)/members/$(request.auth.uid));
    }
    function isPairedDisplay(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sparkonRooms/$(roomId)/displays/$(request.auth.uid));
    }
    function revealOpen(roomId) {
      return roomData(roomId).phase in ['reveal', 'scores', 'finished'];
    }

    // Profile + entitlements (UID-owned)
    match /sparkonUsers/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && (!('entitlements' in request.resource.data)
            || request.resource.data.entitlements.keys().hasOnly(['premiumTheme', 'heroTheme']));
      allow delete: if false;

      match /collection/{instanceId} {
        allow read: if isSelf(uid);
        // Pilot client mint — NOT production-safe; create still self-only
        allow create: if isSelf(uid)
          && request.resource.data.conceptId is string
          && request.resource.data.conceptId != 'pi'
          && request.resource.data.edition in ['basic', 'standard', 'premium', 'hero'];
        allow update, delete: if false;
      }
    }

    // Room code directory — code secrecy is discovery control
    match /sparkonCodes/{code} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId', 'createdAt'])
        && request.resource.data.roomId is string;
      allow update, delete: if false;
    }

    // TV pairing codes (short-lived). Anon auth OK.
    match /sparkonDisplayCodes/{code} {
      allow read: if signedIn() || resource.data.status == 'waiting';
      allow create: if signedIn()
        && request.resource.data.status == 'waiting'
        && request.resource.data.displayId == request.auth.uid
        && request.resource.data.roomId == null
        && request.resource.data.keys().hasOnly(['displayId', 'status', 'roomId', 'createdAt', 'expiresAt']);
      // waiting → paired with roomId (host attach); displayId immutable
      allow update: if signedIn()
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'paired'
        && request.resource.data.roomId is string
        && request.resource.data.displayId == resource.data.displayId;
      allow delete: if false;
    }

    match /sparkonRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.phase == 'lobby';
      // Host advances phase/scores. Members may bump publicState only (answeredCount).
      allow update: if signedIn() && request.resource.data.hostUid == resource.data.hostUid && (
        resource.data.hostUid == request.auth.uid
        || (
          isMember(roomId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['publicState', 'updatedAt'])
          && request.resource.data.phase == resource.data.phase
          && request.resource.data.revision == resource.data.revision
        )
      );
      allow delete: if false;

      match /members/{memberId} {
        allow read: if signedIn()
          && (isRoomHost(roomId) || isMember(roomId) || isPairedDisplay(roomId));
        // Self-create only (no room get — same-txn createRoom writes room+member together)
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.nickname is string
          && request.resource.data.approved is bool
          && request.resource.data.isHost is bool
          && request.resource.data.ready is bool;
        allow update: if signedIn() && (
          (request.auth.uid == memberId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['ready', 'nickname', 'homeLabel', 'connected', 'lastSeen', 'isGuest']))
          || (isRoomHost(roomId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['approved', 'connected', 'ready', 'nickname']))
        );
        allow delete: if false;
      }

      match /answers/{answerId} {
        allow read: if signedIn() && (
          resource.data.uid == request.auth.uid
          || isRoomHost(roomId)
          || revealOpen(roomId)
        );
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.uid
          && answerId == request.resource.data.roundId + '_' + request.auth.uid
          && request.resource.data.locked == true
          && request.resource.data.keys().hasOnly(['uid', 'roundId', 'conceptId', 'optionId', 'locked', 'lockedAt']);
        allow update, delete: if false;
      }

      match /displays/{displayId} {
        allow read: if signedIn()
          && (isRoomHost(roomId) || isMember(roomId)
              || request.auth.uid == displayId || isPairedDisplay(roomId));
        allow create: if signedIn() && (
          isRoomHost(roomId)
          || (request.auth.uid == displayId
              && request.resource.data.keys().hasOnly(['pairedAt', 'readOnly', 'label', 'lastSeen']))
        );
        allow update: if signedIn() && (
          isRoomHost(roomId)
          || (request.auth.uid == displayId
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['lastSeen', 'label']))
        );
        allow delete: if false;
      }
    }

    // Optional alternate collection root (still never notes)
    match /users/{uid}/sparkon/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
